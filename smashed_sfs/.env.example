# Copy this file to .env and fill in real values. .env is gitignored and
# must never be committed - it holds this machine's actual database
# credentials.
#
# DB_USER should be a least-privilege MySQL user with access scoped to
# just this project's database (see CLAUDE.md/README for the CREATE USER /
# GRANT statement), not the MySQL root account.
DB_USER=smashed_sfs_app
DB_PASSWORD=

# Only needed for a real deployment (DJANGO_DEBUG=False) - local dev can
# leave this unset and use the built-in dev-only fallback.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True

# Optional: powers the country breakdown on the Online Users admin page
# (/admin/online-users/). Free account + key at
# https://www.maxmind.com/en/geolite2/signup, then Account > License Keys.
# Leave unset to skip - the breakdown just shows everything as "Unknown".
MAXMIND_LICENSE_KEY=
