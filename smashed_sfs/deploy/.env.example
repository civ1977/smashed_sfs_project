# Copy this to .env on the VPS (NOT committed to git - .gitignore already
# excludes .env) and fill in real values. gunicorn.service loads this file
# via EnvironmentFile=.

# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-me-with-a-real-random-secret-key

DJANGO_DEBUG=False

# Comma-separated. Include your domain and/or the VPS's public IP.
DJANGO_ALLOWED_HOSTS=your-domain.com,203.0.113.10

# Comma-separated, must include the scheme (https://...). Needed once you
# have a domain and HTTPS set up - matches DJANGO_ALLOWED_HOSTS above.
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.com

# Set to True once you have a domain + TLS cert in front of this (e.g. via
# nginx/certbot) - turns on SECURE_SSL_REDIRECT, Secure session/CSRF
# cookies, and HSTS. Leave False on plain-HTTP deployments (like an IP with
# no cert yet) - these would otherwise redirect-loop or drop cookies.
DJANGO_HTTPS_ENABLED=False

# settings.py refuses to start without both of these - a least-privilege
# MySQL user scoped to just the smashed_sfs database (never root). Create
# it on the VPS first:
#   sudo mysql -u root -p
#   CREATE USER 'smashed_sfs_app'@'localhost' IDENTIFIED BY 'a-real-password-here';
#   GRANT SELECT, INSERT, UPDATE, DELETE, CREATE, ALTER, INDEX, DROP, REFERENCES
#     ON smashed_sfs.* TO 'smashed_sfs_app'@'localhost';
#   FLUSH PRIVILEGES;
DB_USER=smashed_sfs_app
DB_PASSWORD=replace-me

# settings.py refuses to start without this - encrypts each teacher's own
# DeepSeek API key (Lesson Planning tool) at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AI_KEY_ENCRYPTION_KEY=replace-me

# Optional: powers the country breakdown on the Online Users admin page
# (/admin/online-users/). Free account + key at
# https://www.maxmind.com/en/geolite2/signup, then Account > License Keys.
# Leave unset to skip - the breakdown just shows everything as "Unknown".
# MAXMIND_LICENSE_KEY=your-license-key-here

# Optional: "Sign in with Google/Facebook" buttons on the login/register
# pages. Leave either pair unset to just hide that provider's button.
# Google: https://console.cloud.google.com/apis/credentials - create an
#   OAuth client ID (Web application). Authorized redirect URI:
#   https://your-domain-or-ip/accounts/google/login/callback/
# Facebook: https://developers.facebook.com/apps - add the Facebook Login
#   product. Same callback path under /accounts/facebook/login/callback/
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# FACEBOOK_OAUTH_CLIENT_ID=
# FACEBOOK_OAUTH_CLIENT_SECRET=

# Optional: real outgoing email for password-reset links. Leave unset to
# keep emails printing to the console/log instead of actually sending.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-address@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# EMAIL_USE_TLS=True
